{
  "name": "blind",
  "version": "0.0.0",
  "private": true,
  "description": "A macOS terminal emulator organised around named Sessions that persist across app quits and OS restarts.",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "blind": "out/cli/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:native": "node-gyp rebuild --directory=native --target=$(node -p \"require('electron/package.json').version\") --dist-url=https://electronjs.org/headers",
    "dev": "npm run build:native && electron-vite dev",
    "build": "npm run build:native && electron-vite build",
    "install-app": "test -z \"$(git status --porcelain)\" || { echo 'install-app builds the last commit only, and there are uncommitted changes. Run blind install instead, which stashes them for the build.' >&2; exit 1; }; npm run build && iconutil -c icns build/icon.iconset -o build/icon.icns && electron-builder --mac && rm -rf /Applications/Blind.app && ditto dist/mac*/Blind.app /Applications/Blind.app",
    "build:cli": "vite build --config vite.cli.config.ts && chmod +x out/cli/main.js",
    "docs": "vite build --config vite.docs.config.ts && node out/docs/main.js",
    "prepare": "(git config core.hooksPath .githooks || true) && npm run build:cli",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper && node node_modules/electron/install.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json && tsc -p tsconfig.cli.json",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "neostandard": "^0.14.1",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "neostandard": {
      "typescript": "~6.0.3"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
